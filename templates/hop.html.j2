{% extends "base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% set agg = hop.aggregate %}
{% set med = hop.medians %}
{% set thiol_forward = hop.thiol_3mh_qualitative in ('high', 'very_high_bound') or hop.thiol_4mmp_qualitative in ('high', 'very_high_bound') %}
{% set thiol_some = hop.thiol_3mh_qualitative in ('significant', 'significant_bound') or hop.thiol_4mmp_qualitative in ('significant', 'significant_bound') %}
{% block content %}
<article class="container ref-article">
  {{ m.breadcrumb([('Home', '/'), ('Hops', '/hops/'), (hop.name, None)]) }}

  <header class="ref-head">
    <p class="ref-eyebrow">
      Hop variety{% if hop.origin %} · <span aria-label="{{ hop.origin.country }}">{{ hop.origin.flag }}</span> {{ hop.origin.country }}{% endif %}
    </p>
    <h1 class="ref-title">{{ hop.name }}</h1>
    <p class="ref-lede">
      {{ hop.sensory_summary | capitalize }}.
      {%- if hop.origin %} {{ hop.origin.detail }}.{% endif %}
    </p>
    <dl class="ref-facts">
      <div><dt>Alpha acid</dt><dd>{{ (agg.alpha_acid if agg else None) | rng }} %</dd></div>
      <div><dt>Total oil</dt><dd>{{ (agg.total_oil if agg else None) | rng }} mL/100 g</dd></div>
      <div><dt>3MH-family thiols</dt><dd>{{ m.tier_badge(hop.thiol_3mh_qualitative) }}</dd></div>
      <div><dt>4MMP</dt><dd>{{ m.tier_badge(hop.thiol_4mmp_qualitative) }}</dd></div>
      <div><dt>Data</dt><dd>{{ m.confidence(hop.data_quality_note) }}</dd></div>
    </dl>
  </header>

  <section class="ref-section" aria-labelledby="aroma-h">
    <h2 id="aroma-h">Aroma in one line</h2>
    <p>
      Brewers describe {{ hop.name }} as <strong>{{ hop.sensory_summary }}</strong>.
      In Hoparoma's hop notes its thiol character is filed as <em>{{ hop.thiol_note_summary }}</em>.
      {% if thiol_forward -%}
      That places it among the varieties whose tropical and citrus punch depends heavily on bound thiol precursors, which only show up when the yeast releases them.
      {%- elif thiol_some -%}
      Part of its fruit character comes from bound thiol precursors; the rest rides on the oils listed below.
      {%- else -%}
      Its aroma is carried mainly by the essential oils listed below rather than by thiols.
      {%- endif %}
    </p>
  </section>

  <section class="ref-section" aria-labelledby="values-h">
    <h2 id="values-h">Brewing values</h2>
    <p class="ref-note">
      Typical ranges come from supplier datasheets and lot certificates; the median column pools {{ hop.n_sources }} published sources. Oil fractions are percent of total oil.
    </p>
    <div class="ref-table-wrap">
      <table class="ref-table">
        <thead>
          <tr><th scope="col">Measure</th><th scope="col">Typical range</th><th scope="col">Median</th></tr>
        </thead>
        <tbody>
          <tr><th scope="row">Alpha acid %</th><td>{{ (agg.alpha_acid if agg else None) | rng }}</td><td>{{ med.alpha_acid.median | n }}</td></tr>
          <tr><th scope="row">Beta acid %</th><td>{{ (agg.beta_acid if agg else None) | rng }}</td><td>–</td></tr>
          <tr><th scope="row">Cohumulone % of alpha</th><td>{{ (agg.cohumulone if agg else None) | rng }}</td><td>–</td></tr>
          <tr><th scope="row">Total oil mL/100 g</th><td>{{ (agg.total_oil if agg else None) | rng }}</td><td>{{ med.total_oil.median | n }}</td></tr>
          <tr><th scope="row">Myrcene %</th><td>{{ (agg.myrcene if agg else None) | rng }}</td><td>{{ med.myrcene.median | n }}</td></tr>
          <tr><th scope="row">Humulene %</th><td>{{ (agg.humulene if agg else None) | rng }}</td><td>{{ med.humulene.median | n }}</td></tr>
          <tr><th scope="row">β-Caryophyllene %</th><td>{{ (agg.caryophyllene if agg else None) | rng }}</td><td>{{ med.beta_caryophyllene.median | n }}</td></tr>
          <tr><th scope="row">Farnesene %</th><td>{{ (agg.farnesene if agg else None) | rng }}</td><td>{{ med.farnesene.median | n }}</td></tr>
          <tr><th scope="row">β-Pinene %</th><td>{{ (agg.b_pinene if agg else None) | rng }}</td><td>{{ med.b_pinene.median | n }}</td></tr>
          <tr><th scope="row">Linalool %</th><td>{{ (agg.linalool if agg else None) | rng }}</td><td>{{ med.linalool.median | n }}</td></tr>
          <tr><th scope="row">Geraniol %</th><td>{{ (agg.geraniol if agg else None) | rng }}</td><td>{{ med.geraniol.median | n }}</td></tr>
        </tbody>
      </table>
    </div>
    {%- if agg %}
    <p class="ref-source">Range source: {{ agg.data_source }}{% if hop.aggregate_is_backfill %} (aggregate derived from pooled medians; beta acid and cohumulone not specified){% endif %}.</p>
    {%- endif %}
  </section>

  <section class="ref-section" aria-labelledby="thiol-h">
    <h2 id="thiol-h">Thiol potential</h2>
    <div class="ref-tiers">
      <div class="ref-tier">
        <span class="ref-tier__label">3MH family (passionfruit, grapefruit)</span>
        {{ m.tier_badge(hop.thiol_3mh_qualitative) }}
      </div>
      <div class="ref-tier">
        <span class="ref-tier__label">4MMP (blackcurrant, catty)</span>
        {{ m.tier_badge(hop.thiol_4mmp_qualitative) }}
      </div>
    </div>
    <p>
      Most of a hop's thiol aroma sits in the cone as odourless precursors bound to cysteine or glutathione; free thiols are a small fraction of the pool {{ m.cite('gros-2012') }} {{ m.cite('kishimoto-2009') }}.
      The tiers above summarise published precursor measurements and supplier statements for this variety. They are qualitative on purpose: Hoparoma's internal weighting is not published, and lot-to-lot variation is large.
    </p>
    {%- if agg and agg.note %}
    <p class="ref-note">Variety note: {{ agg.note }}.</p>
    {%- endif %}
  </section>

  {%- if hop.crop_years %}
  <section class="ref-section" aria-labelledby="crop-h">
    <h2 id="crop-h">Crop year lots</h2>
    <p class="ref-note">
      Year-specific rows come from published lot certificates of analysis. Where a lot reports only alpha and oil, the composition columns fall back to the variety's typical range, and the note says so. Rows marked carry-forward are placeholders until that harvest is analysed.
    </p>
    <div class="ref-table-wrap">
      <table class="ref-table ref-table--wide">
        <thead>
          <tr>
            <th scope="col">Crop</th><th scope="col">Alpha %</th><th scope="col">Beta %</th><th scope="col">Oil mL/100 g</th>
            <th scope="col">Myrcene %</th><th scope="col">Humulene %</th><th scope="col">Caryophyllene %</th>
          </tr>
        </thead>
        <tbody>
          {%- for y in hop.crop_years %}
          <tr>
            <th scope="row">{{ y.year }}</th>
            <td>{{ y.alpha_acid | rng }}</td><td>{{ y.beta_acid | rng }}</td><td>{{ y.total_oil | rng }}</td>
            <td>{{ y.myrcene | rng }}</td><td>{{ y.humulene | rng }}</td><td>{{ y.caryophyllene | rng }}</td>
          </tr>
          {%- endfor %}
        </tbody>
      </table>
    </div>
    <ul class="ref-lotnotes">
      {%- for y in hop.crop_years %}
      <li><strong>{{ y.year }}</strong> · {{ y.data_source }}{% if y.note %} <span class="ref-table__note">{{ y.note }}</span>{% endif %}</li>
      {%- endfor %}
    </ul>
  </section>
  {%- endif %}

  <section class="ref-section" aria-labelledby="yeast-h">
    <h2 id="yeast-h">Which yeast brings it out</h2>
    {%- if thiol_forward %}
    <p>
      To cash in the bound precursors, ferment with a strain rated <strong>high</strong> for β-lyase activity:
      {% for y in high_yeasts %}<a href="{{ '/yeast/' ~ y.slug ~ '/' if y.has_page else '/yeast/#' ~ y.slug }}">{{ y.display_name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}.
      A clean Chico-type strain (US-05, WLP001) leaves most of this potential locked; London III and Conan lineage strains sit in between.
    </p>
    {%- elif thiol_some %}
    <p>
      A medium or high β-lyase strain, such as the London III family, LalBrew Pomona, or any of the thiol-forward strains, brings out the bound fraction. A clean Chico-type strain leaves it mostly bound, which is fine if you want the oil-driven character alone.
    </p>
    {%- else %}
    <p>
      Thiols are not this hop's story. Pick the yeast for its ester and terpene handling: a β-glucosidase-active hazy strain lifts the oils, a clean strain keeps them precise.
    </p>
    {%- endif %}
    <p class="ref-note">Rule of thumb only. See the <a href="/yeast/">yeast table</a> for every strain's rating and the literature behind it.</p>
  </section>

  <section class="ref-section ref-cta" aria-labelledby="app-h">
    <h2 id="app-h">In Hoparoma</h2>
    <p>
      Hoparoma computes how much of {{ hop.name }}'s aroma compounds survive your boil, whirlpool, and dry hop, and models the thiol side across yeast, hop, malt, and Phantasm together. The result is a research-based estimate of where the beer is likely to land, not a guarantee.
    </p>
    <a class="cta-pill" href="{{ cfg.app_store_url }}" target="_blank" rel="noopener">Get Hoparoma on the App Store</a>
  </section>

  <section class="ref-section ref-sources" aria-labelledby="src-h">
    <h2 id="src-h">Sources and data quality</h2>
    <ul>
      <li>Data quality: {{ m.confidence(hop.data_quality_note) }} <span class="ref-note">({{ hop.data_quality_note }})</span></li>
      {%- if agg %}<li>Typical ranges: {{ agg.data_source }}</li>{% endif %}
      {%- for y in hop.crop_years %}<li>Crop {{ y.year }}: {{ y.data_source }}</li>{% endfor %}
      <li>Thiol background: {{ m.cite('gros-2012') }}, {{ m.cite('kishimoto-2009') }}, {{ m.cite('takoi-2009') }}, {{ m.cite('roland-2016') }}</li>
      <li>Supplier references: {{ m.cite('ych') }}, {{ m.cite('hpa') }}, {{ m.cite('barthhaas') }}, {{ m.cite('nz-hops') }}, {{ m.cite('hop-alliance') }}</li>
    </ul>
    <p class="ref-note">Full list with links on the <a href="/sources/">sources page</a>. Spotted an error? <a href="mailto:{{ cfg.contact_email }}">Tell us</a> and we will correct the dataset in the next release.{% if cfg.dataset_license %} This page's tables are published under <a href="{{ cfg.dataset_license }}" rel="license noopener" target="_blank">{{ cfg.dataset_license_name }}</a>; reuse with credit and a link.{% endif %}</p>
  </section>
</article>
{% endblock %}
